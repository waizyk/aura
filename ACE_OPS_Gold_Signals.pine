//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  ACE OPS · Gold Signals v1.1 (chart edition)
//  Trend-following entries with confirmed SL / TP, HOLD-vs-EXIT guidance,
//  and Kelly-criterion lot sizing for HFM accounts (USC cent, ZAR or USD).
//
//  Alerts come from the ACE OPS app (GitHub engine), which uses the same rules.
//  Default settings were chosen from a backtest on gold (2 years of H1 and
//  ~2.5 months of M15 data). See ACE_OPS_Guide.md for the numbers.
//  Nothing here is financial advice. Past results do not guarantee future results.
// ═══════════════════════════════════════════════════════════════════════════
indicator("ACE OPS · Gold Signals", shorttitle="ACE OPS", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ───────────────────────────── INPUT GROUPS ─────────────────────────────────
const string G_SIG   = "1 · Signal engine"
const string G_RISK  = "2 · Stop loss & targets"
const string G_MGMT  = "3 · Hold / exit management"
const string G_KELLY = "4 · Account & Kelly lot size"
const string G_SESS  = "5 · Sessions"
const string G_VIS   = "6 · Visuals"

const string EXIT_HOLD  = "Hold to TP / SL (best tested)"
const string EXIT_SMART = "Smart exit: rejection or slow-EMA close"
const string ACC_CENT   = "HFM Cent account (USC)"
const string ACC_ZAR    = "HFM ZAR account (standard lots)"
const string ACC_USD    = "HFM USD account (standard lots)"
const string S_ALL      = "All hours (best tested)"
const string S_NY       = "NY open only (14:00-18:00 SA in US summer)"
const string S_LONNY    = "London + NY opens"
const string S_CUSTOM   = "Custom (SA time)"

// 1 · Signal engine
emaFastLen    = input.int(9,   "Fast EMA",  minval=1, group=G_SIG)
emaSlowLen    = input.int(21,  "Slow EMA",  minval=1, group=G_SIG)
useTrend      = input.bool(true, "Only trade WITH the trend EMA", group=G_SIG,
     tooltip="Buys only above the trend EMA, sells only below it. This was the biggest improvement in testing.")
emaTrendLen   = input.int(200, "Trend EMA", minval=1, group=G_SIG)
confirmCandle = input.bool(true, "Require confirmation candle", group=G_SIG,
     tooltip="BUY only if the cross candle closes green, SELL only if it closes red.")
useHtf        = input.bool(false, "Extra filter: higher-timeframe EMA 50", group=G_SIG)
htfTf         = input.timeframe("240", "Higher timeframe", group=G_SIG)
useAdx        = input.bool(false, "ADX trend-strength filter", group=G_SIG,
     tooltip="Tested on gold: it made results worse, so it is off by default.")
adxMin        = input.int(20, "Min ADX", minval=1, group=G_SIG)

// 2 · Stop loss & targets
atrLen     = input.int(14, "ATR period", minval=1, group=G_RISK)
atrMultSL  = input.float(0.3, "SL buffer beyond signal candle (x ATR)", minval=0.0, step=0.1, group=G_RISK,
     tooltip="SL sits below the signal candle's low (BUY) or above its high (SELL), plus this ATR buffer.")
riskReward = input.float(3.0, "Final take profit (R:R)", minval=1.0, step=0.5, group=G_RISK)
maxSlAtr   = input.float(0.0, "Skip signal if SL is wider than x ATR (0 = off)", minval=0.0, step=0.5, group=G_RISK)
lateEntryR = input.float(0.25, "Late-entry limit (R)", minval=0.0, step=0.05, group=G_RISK,
     tooltip="If price has already moved this many R past the entry, the table tells you not to chase.")

// 3 · Hold / exit management
exitMode   = input.string(EXIT_HOLD, "Exit mode", options=[EXIT_HOLD, EXIT_SMART], group=G_MGMT,
     tooltip="HOLD: trades run to SL or final TP, and rejection / trend-break are shown only as warnings.\nSMART: the indicator closes the trade on a confirmed rejection or a close beyond the slow EMA.")
beAfterTp1 = input.bool(false, "Move SL to breakeven after TP1", group=G_MGMT,
     tooltip="Feels safer, but in testing it cut profits roughly in half on H1 gold.")
rejWickPct = input.float(60, "Rejection: wick at least % of candle", minval=30, maxval=95, group=G_MGMT)
rejMinAtr  = input.float(0.8, "Rejection: candle size at least x ATR", minval=0.1, step=0.1, group=G_MGMT)

// 4 · Account & Kelly
acctType       = input.string(ACC_CENT, "HFM account you trade on", options=[ACC_CENT, ACC_ZAR, ACC_USD], group=G_KELLY,
     tooltip="Cent (USC): best for small balances, 0.01 lot of gold = 1 US cent per $1 move.\nZAR / USD: standard lots, 0.01 lot of gold = $1 per $1 move (about R16-17).")
balanceIn      = input.float(6000, "Balance, exactly as MT5 shows it (USC / ZAR / USD)", minval=0.01, group=G_KELLY,
     tooltip="Type the balance in the account's own currency.\nCent account: USC (R1,000 is about 6,000 USC).\nZAR account: rand.\nUSD account: dollars.\nUpdate weekly.")
contractMode   = input.string("Auto", "Contract size", options=["Auto", "Manual"], group=G_KELLY,
     tooltip="Auto: gold = 100 oz per standard lot, silver = 5000, forex = 100,000. Always check your broker's contract specification.")
contractManual = input.float(100, "Manual contract size per 1.00 standard lot", minval=0.0001, group=G_KELLY)
kellyFrac      = input.float(0.25, "Kelly fraction (0.25 = quarter Kelly)", minval=0.05, maxval=1.0, step=0.05, group=G_KELLY)
maxRiskPct     = input.float(2.0, "Max risk per trade (%)", minval=0.1, maxval=10, step=0.1, group=G_KELLY)
startRiskPct   = input.float(1.0, "Risk % until Kelly has enough trades", minval=0.1, maxval=5, step=0.1, group=G_KELLY)
minTradesKelly = input.int(30, "Trades needed before trusting Kelly", minval=10, group=G_KELLY)
useLiveFx      = input.bool(true, "Use live USD/ZAR rate", group=G_KELLY)
manualUsdZar   = input.float(16.6, "Manual USD/ZAR (if live rate unavailable)", minval=0.0001, group=G_KELLY)

// 5 · Sessions
sessMode   = input.string(S_ALL, "Take signals during", options=[S_ALL, S_NY, S_LONNY, S_CUSTOM], group=G_SESS)
customSess = input.session("1400-1800", "Custom session (SA time)", group=G_SESS)
shadeBest  = input.bool(true, "Shade the New York open window (best hours)", group=G_SESS)

// 6 · Visuals
showFast   = input.bool(true, "Show fast EMA", group=G_VIS)
showSlow   = input.bool(true, "Show slow EMA", group=G_VIS)
showTrend  = input.bool(true, "Show trend EMA", group=G_VIS)
fastColor  = input.color(color.new(#00e676, 0), "Fast EMA colour", group=G_VIS)
slowColor  = input.color(color.new(#ff9800, 0), "Slow EMA colour", group=G_VIS)
trendColor = input.color(color.new(#9e9e9e, 0), "Trend EMA colour", group=G_VIS)
showZones  = input.bool(true, "Show risk / reward zones", group=G_VIS)
showWarn   = input.bool(true, "Show rejection / exit warnings", group=G_VIS)
showTable  = input.bool(true, "Show dashboard", group=G_VIS)
compactTbl = input.bool(false, "Compact dashboard (phones)", group=G_VIS)
tblPos     = input.string("Top right", "Dashboard position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=G_VIS)

// ───────────────────────────── CORE CALCULATIONS ────────────────────────────
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)
atr      = ta.atr(atrLen)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
// Non-repainting higher-timeframe EMA (uses the last CLOSED HTF bar only)
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)

// Sessions (DST handled automatically by using the exchange cities' time zones)
bool nyOpenWin  = not na(time(timeframe.period, "0800-1200", "America/New_York"))
bool lateNyWin  = not na(time(timeframe.period, "1200-1700", "America/New_York"))
bool londonWin  = not na(time(timeframe.period, "0700-1130", "Europe/London"))
bool customWin  = not na(time(timeframe.period, customSess, "Africa/Johannesburg"))
bool inSession  = sessMode == S_ALL ? true : sessMode == S_NY ? nyOpenWin : sessMode == S_LONNY ? (nyOpenWin or londonWin) : customWin

// ───────────────────────────── ENTRY SIGNALS ────────────────────────────────
crossUp = ta.crossover(emaFast, emaSlow)
crossDn = ta.crossunder(emaFast, emaSlow)

buySetup  = crossUp and (not confirmCandle or close > open)
sellSetup = crossDn and (not confirmCandle or close < open)

trendOkL = not useTrend or close > emaTrend
trendOkS = not useTrend or close < emaTrend
htfOkL   = not useHtf or close > htfEma
htfOkS   = not useHtf or close < htfEma
adxOk    = not useAdx or adx >= adxMin

slLong   = low  - atr * atrMultSL
slShort  = high + atr * atrMultSL
slWideL  = maxSlAtr > 0 and (close - slLong)  > maxSlAtr * atr
slWideS  = maxSlAtr > 0 and (slShort - close) > maxSlAtr * atr

buySignal  = barstate.isconfirmed and buySetup  and trendOkL and htfOkL and adxOk and inSession and not slWideL
sellSignal = barstate.isconfirmed and sellSetup and trendOkS and htfOkS and adxOk and inSession and not slWideS

// ───────────────────────────── STATE ────────────────────────────────────────
var int   pos      = 0        // 1 = long, -1 = short, 0 = flat
var float entry    = na
var float sl       = na
var float risk     = na
var float tp1      = na
var float tp2      = na
var float tp3      = na
var bool  tp1Hit   = false
var bool  tp2Hit   = false
var int   entryBar = na
var bool  rejFlag  = false
var float rejLevel = na
var string advice  = "WAIT for a signal"
var float lotsAtEntry    = na
var float riskPctAtEntry = na
var float riskZarAtEntry = na

// Track record (in R) used for the Kelly calculation
var int   nTrades  = 0
var int   nWins    = 0
var float sumWinR  = 0.0
var float sumLossR = 0.0
var float equityR  = 0.0
var float peakR    = 0.0
var float maxDdR   = 0.0
var float lastR    = na

// Drawings
var line lnEntry = na
var line lnSl    = na
var line lnTp1   = na
var line lnTp2   = na
var line lnTp3   = na
var box  bxRisk  = na
var box  bxRew   = na

// Per-bar events
bool evBuy  = false
bool evSell = false
bool evTp1  = false
bool evTp2  = false
bool evTp   = false
bool evSl   = false
bool evBe   = false
bool evExit = false
bool evRev  = false
bool evRej  = false
bool evWarn = false
var bool warnOn = false

// ───────────────────────────── KELLY + LOT SIZE ─────────────────────────────
float winRate = nTrades > 0 ? float(nWins) / nTrades : na
int   nLoss   = nTrades - nWins
float avgWin  = nWins > 0 ? sumWinR / nWins : na
float avgLoss = nLoss > 0 ? sumLossR / nLoss : na
float payoff  = not na(avgWin) and not na(avgLoss) and avgLoss > 0 ? avgWin / avgLoss : na
float kellyFull = not na(payoff) and payoff > 0 ? winRate - (1 - winRate) / payoff : na
bool  kellyReady = nTrades >= minTradesKelly and not na(kellyFull)
bool  noEdge     = kellyReady and kellyFull <= 0
float riskPctNow = kellyReady ? (noEdge ? 0.0 : math.min(kellyFull * kellyFrac * 100, maxRiskPct)) : startRiskPct
float expectR    = nTrades > 0 ? equityR / nTrades : na

bool  isCent   = acctType == ACC_CENT
bool  isZarAcc = acctType == ACC_ZAR
string accCcy  = isCent ? "USC" : isZarAcc ? "ZAR" : "USD"
string tk      = str.upper(syminfo.ticker)
bool  isGold   = str.contains(tk, "XAU") or str.contains(tk, "GOLD")
bool  isSilver = str.contains(tk, "XAG") or str.contains(tk, "SILVER")
float autoContract = isGold ? 100.0 : isSilver ? 5000.0 : syminfo.type == "forex" ? 100000.0 : 1.0
float contractStd  = contractMode == "Auto" ? autoContract : contractManual
float contract     = isCent ? contractStd / 100.0 : contractStd

string quoteCcy   = syminfo.currency
float usdZarLive  = request.security("FX_IDC:USDZAR", "D", close, ignore_invalid_symbol=true)
float usdZar      = useLiveFx and not na(usdZarLive) ? usdZarLive : manualUsdZar
float fxQuoteLive = request.security("FX_IDC:" + quoteCcy + "ZAR", "D", close, ignore_invalid_symbol=true)
// quote currency -> ZAR (gold is quoted in USD, so this is USD/ZAR)
float fxRate      = quoteCcy == "ZAR" ? 1.0 : quoteCcy == "USD" ? usdZar : (useLiveFx and not na(fxQuoteLive) ? fxQuoteLive : usdZar)
// account currency -> ZAR
float accToZar    = isZarAcc ? 1.0 : isCent ? usdZar / 100.0 : usdZar
float balanceZar  = balanceIn * accToZar
f_acc(float zar) => str.tostring(zar / accToZar, isCent ? "#,###" : "#,###.##") + " " + accCcy

// Lot size for a given stop distance
f_lots(float slDist, float rPct) =>
    float lossPerLot = slDist * contract * fxRate           // ZAR lost per 1.00 lot if SL is hit
    float riskZar    = balanceZar * rPct / 100.0
    float raw        = lossPerLot > 0 ? riskZar / lossPerLot : na
    float lots       = na(raw) ? na : math.floor(raw * 100) / 100.0
    float minLotRisk = lossPerLot > 0 ? 0.01 * lossPerLot / balanceZar * 100.0 : na
    [lots, riskZar, minLotRisk]

// ───────────────────────────── TRADE MANAGEMENT ─────────────────────────────
float closePx = na
string closeWhy = ""
bool smartExit = exitMode == EXIT_SMART

rng       = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bearRej   = rng > 0 and upperWick / rng * 100 >= rejWickPct and rng >= rejMinAtr * atr
bullRej   = rng > 0 and lowerWick / rng * 100 >= rejWickPct and rng >= rejMinAtr * atr

if barstate.isconfirmed and pos != 0
    if pos == 1
        if low <= sl
            closePx := sl
            closeWhy := (tp1Hit and beAfterTp1) ? "BE" : "SL"
        else
            if not tp1Hit and not na(tp1) and high >= tp1
                tp1Hit := true
                evTp1 := true
            if not tp2Hit and not na(tp2) and high >= tp2
                tp2Hit := true
                evTp2 := true
            if high >= tp3
                closePx := tp3
                closeWhy := "TP"
    else
        if high >= sl
            closePx := sl
            closeWhy := (tp1Hit and beAfterTp1) ? "BE" : "SL"
        else
            if not tp1Hit and not na(tp1) and low <= tp1
                tp1Hit := true
                evTp1 := true
            if not tp2Hit and not na(tp2) and low <= tp2
                tp2Hit := true
                evTp2 := true
            if low <= tp3
                closePx := tp3
                closeWhy := "TP"

    // Hold / exit read-out (only while the trade is still open)
    if na(closePx)
        if beAfterTp1 and tp1Hit
            sl := entry
        bool rejConfirmed = rejFlag and (pos == 1 ? close < rejLevel : close > rejLevel)
        bool trendBroken  = pos == 1 ? close < emaSlow : close > emaSlow
        if rejConfirmed or trendBroken
            if smartExit
                closePx  := close
                closeWhy := "EXIT"
            else
                evWarn := not warnOn
                warnOn := true
                advice := rejConfirmed ? "HOLD (warning: rejection confirmed)" : "HOLD (warning: closed past slow EMA)"
        else
            warnOn := false
            bool newRej = pos == 1 ? bearRej : bullRej
            bool weak   = pos == 1 ? close < emaFast : close > emaFast
            advice := newRej ? "CAUTION: rejection candle, watch next close" : weak ? "HOLD: pullback inside trend" : "HOLD: trend intact, let it run"
        rejFlag  := pos == 1 ? bearRej : bullRej
        rejLevel := pos == 1 ? low : high
        if rejFlag
            evRej := true

// Opposite signal while in a trade = invalidation / reversal
bool flipToBuy  = buySignal  and pos == -1
bool flipToSell = sellSignal and pos == 1
if na(closePx) and (flipToBuy or flipToSell)
    closePx  := close
    closeWhy := "REV"

// Record the closed trade
if not na(closePx) and pos != 0
    float tradeR = (closePx - entry) / risk * pos
    lastR   := tradeR
    nTrades += 1
    if tradeR > 0
        nWins   += 1
        sumWinR += tradeR
    else
        sumLossR += -tradeR
    equityR += tradeR
    peakR   := math.max(peakR, equityR)
    maxDdR  := math.max(maxDdR, peakR - equityR)
    evTp   := closeWhy == "TP"
    evSl   := closeWhy == "SL"
    evBe   := closeWhy == "BE"
    evExit := closeWhy == "EXIT"
    evRev  := closeWhy == "REV"
    advice := closeWhy == "TP" ? "TARGET HIT: bank it, wait for next signal" : closeWhy == "SL" ? "STOPPED OUT: normal, wait for next signal" : closeWhy == "BE" ? "Closed at breakeven" : closeWhy == "EXIT" ? "SMART EXIT: closed early" : "REVERSED: old trade invalidated"
    pos := 0
    // Freeze the drawings of the finished trade
    if not na(lnEntry)
        line.set_x2(lnEntry, bar_index)
        line.set_x2(lnSl, bar_index)
        line.set_x2(lnTp3, bar_index)
        if not na(lnTp1)
            line.set_x2(lnTp1, bar_index)
        if not na(lnTp2)
            line.set_x2(lnTp2, bar_index)
    if not na(bxRisk)
        box.set_right(bxRisk, bar_index)
        box.set_right(bxRew, bar_index)

// ───────────────────────────── NEW ENTRIES ──────────────────────────────────
int newDir = buySignal ? 1 : sellSignal ? -1 : 0
if newDir != 0 and pos == 0
    float e = close
    float s = newDir == 1 ? slLong : slShort
    float r = math.abs(e - s)
    if r > 0
        pos      := newDir
        entry    := e
        sl       := s
        risk     := r
        tp1      := riskReward > 1 ? e + newDir * r * 1.0 : na
        tp2      := riskReward > 2 ? e + newDir * r * 2.0 : na
        tp3      := e + newDir * r * riskReward
        tp1Hit   := false
        tp2Hit   := false
        rejFlag  := false
        warnOn   := false
        entryBar := bar_index
        [lt, rz, mlr] = f_lots(r, riskPctNow)
        lotsAtEntry    := lt
        riskPctAtEntry := riskPctNow
        riskZarAtEntry := rz
        evBuy  := newDir == 1
        evSell := newDir == -1
        advice := noEdge ? "SIGNAL, but Kelly says NO EDGE: skip" : "NEW TRADE: place SL and TP now, then HOLD"

        string lotTxt = noEdge ? "Kelly: no edge, skip" : na(lt) ? "lot n/a" : lt < 0.01 ? "Below 0.01 min lot (min lot = " + str.tostring(mlr, "#.#") + "% risk)" : str.tostring(lt, "#.##") + (isCent ? " cent lots" : " lots")
        string tip = (newDir == 1 ? "BUY " : "SELL ") + syminfo.ticker + "\nEntry: " + str.tostring(e, format.mintick) + "\nSL: " + str.tostring(s, format.mintick) + "\nTP1 (1R): " + (na(tp1) ? "-" : str.tostring(tp1, format.mintick)) + "\nTP2 (2R): " + (na(tp2) ? "-" : str.tostring(tp2, format.mintick)) + "\nFinal TP (" + str.tostring(riskReward) + "R): " + str.tostring(tp3, format.mintick) + "\nLot: " + lotTxt + "\nRisk: R" + str.tostring(rz, "#.##") + " = " + f_acc(rz) + " (" + str.tostring(riskPctNow, "#.##") + "%)"
        label.new(bar_index, newDir == 1 ? low : high, (newDir == 1 ? "BUY\n" : "SELL\n") + (noEdge ? "skip" : na(lt) ? "" : lt < 0.01 ? "<0.01" : str.tostring(lt, "#.##")),
             style=newDir == 1 ? label.style_label_up : label.style_label_down,
             yloc=newDir == 1 ? yloc.belowbar : yloc.abovebar,
             color=newDir == 1 ? color.new(#00c853, 0) : color.new(#d50000, 0),
             textcolor=color.white, size=size.small, tooltip=tip)

        if showZones
            lnEntry := line.new(bar_index, e, bar_index + 1, e, color=color.new(color.white, 20), style=line.style_dashed)
            lnSl    := line.new(bar_index, s, bar_index + 1, s, color=color.new(#ff1744, 0), width=2)
            lnTp3   := line.new(bar_index, tp3, bar_index + 1, tp3, color=color.new(#00e676, 0), width=2)
            lnTp1   := na
            lnTp2   := na
            if not na(tp1)
                lnTp1 := line.new(bar_index, tp1, bar_index + 1, tp1, color=color.new(#00e676, 60), style=line.style_dotted)
            if not na(tp2)
                lnTp2 := line.new(bar_index, tp2, bar_index + 1, tp2, color=color.new(#00e676, 60), style=line.style_dotted)
            bxRisk  := box.new(bar_index, math.max(e, s), bar_index + 1, math.min(e, s), border_color=na, bgcolor=color.new(#ff1744, 88))
            bxRew   := box.new(bar_index, math.max(e, tp3), bar_index + 1, math.min(e, tp3), border_color=na, bgcolor=color.new(#00e676, 90))
        else
            lnEntry := na
            lnSl    := na
            lnTp1   := na
            lnTp2   := na
            lnTp3   := na
            bxRisk  := na
            bxRew   := na

// Extend drawings of the open trade
if pos != 0 and not na(lnEntry)
    line.set_x2(lnEntry, bar_index + 1)
    line.set_x2(lnSl, bar_index + 1)
    line.set_y1(lnSl, sl)
    line.set_y2(lnSl, sl)
    line.set_x2(lnTp3, bar_index + 1)
    if not na(lnTp1)
        line.set_x2(lnTp1, bar_index + 1)
    if not na(lnTp2)
        line.set_x2(lnTp2, bar_index + 1)
    box.set_right(bxRisk, bar_index + 1)
    box.set_right(bxRew, bar_index + 1)

if pos == 0 and not (evTp or evSl or evBe or evExit or evRev) and barstate.isconfirmed and not (evBuy or evSell)
    advice := noEdge ? "NO EDGE on this chart: don't trade it" : "WAIT for a signal"

// ───────────────────────────── PLOTS ────────────────────────────────────────
plot(emaFast,  "Fast EMA",  color=fastColor,  linewidth=1, display=showFast  ? display.all : display.none)
plot(emaSlow,  "Slow EMA",  color=slowColor,  linewidth=1, display=showSlow  ? display.all : display.none)
plot(emaTrend, "Trend EMA", color=trendColor, linewidth=2, display=showTrend ? display.all : display.none)
bgcolor(shadeBest and nyOpenWin and timeframe.isintraday ? color.new(#26a69a, 93) : na, title="NY open window")

plotshape(evTp1,  "TP1 hit",     shape.triangledown, location.abovebar, color.new(#00e676, 30), text="TP1", textcolor=color.new(#00e676, 0), size=size.tiny)
plotshape(evTp2,  "TP2 hit",     shape.triangledown, location.abovebar, color.new(#00e676, 15), text="TP2", textcolor=color.new(#00e676, 0), size=size.tiny)
plotshape(evTp,   "Final TP",    shape.circle,       location.abovebar, color.new(#00e676, 0),  text="🎯 TP", textcolor=color.new(#00e676, 0), size=size.small)
plotshape(evSl,   "Stop loss",   shape.xcross,       location.belowbar, color.new(#ff1744, 0),  text="SL", textcolor=color.new(#ff1744, 0), size=size.small)
plotshape(evBe,   "Breakeven",   shape.square,       location.belowbar, color.new(#90a4ae, 0),  text="BE", textcolor=color.new(#90a4ae, 0), size=size.tiny)
plotshape(evExit, "Smart exit",  shape.square,       location.abovebar, color.new(#ffd600, 0),  text="EXIT", textcolor=color.new(#ffd600, 0), size=size.tiny)
plotshape(evRev,  "Reversed",    shape.diamond,      location.abovebar, color.new(#ffd600, 0),  text="INV", textcolor=color.new(#ffd600, 0), size=size.tiny)
plotshape(showWarn and evRej,  "Rejection candle", shape.flag, location.abovebar, color.new(#ffab00, 0), text="⚠", textcolor=color.new(#ffab00, 0), size=size.tiny)
plotshape(showWarn and evWarn, "Exit warning",     shape.labeldown, location.abovebar, color.new(#ff6d00, 0), text="EXIT?", textcolor=color.white, size=size.tiny)

// ───────────────────────────── DASHBOARD ────────────────────────────────────
tPos = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : position.bottom_left
var table dash = table.new(tPos, 2, 16, bgcolor=color.new(#0b0f14, 10), border_color=color.new(#263238, 0), border_width=1, frame_color=color.new(#ffc400, 0), frame_width=1)
tSize = compactTbl ? size.tiny : size.small

f_row(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color=color.new(#b0bec5, 0), text_size=tSize, text_halign=text.align_left)
    table.cell(dash, 1, r, v, text_color=c, text_size=tSize, text_halign=text.align_right)

f_px(float x) => na(x) ? "-" : str.tostring(x, format.mintick)

if showTable and barstate.islast
    table.clear(dash, 0, 0, 1, 15)
    table.cell(dash, 0, 0, "ACE OPS", text_color=color.new(#ffc400, 0), text_size=tSize, bgcolor=color.new(#000000, 0))
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period + " · " + accCcy, text_color=color.white, text_size=tSize, bgcolor=color.new(#000000, 0))

    string side = pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT"
    color sideC = pos == 1 ? color.new(#00e676, 0) : pos == -1 ? color.new(#ff1744, 0) : color.gray
    f_row(1, "Position", side, sideC)
    color advC = str.contains(advice, "warning") or str.contains(advice, "CAUTION") ? color.new(#ffab00, 0) : str.contains(advice, "NO EDGE") or str.contains(advice, "skip") ? color.new(#ff1744, 0) : color.new(#ffffff, 0)
    f_row(2, "Advice", advice, advC)

    int row = 3
    if pos != 0
        float liveR = (close - entry) / risk * pos
        f_row(row, "Entry", f_px(entry), color.white)
        f_row(row + 1, "Stop loss", f_px(sl), color.new(#ff1744, 0))
        f_row(row + 2, "TP1 / TP2", f_px(tp1) + " / " + f_px(tp2), color.new(#69f0ae, 0))
        f_row(row + 3, "Final TP (" + str.tostring(riskReward) + "R)", f_px(tp3), color.new(#00e676, 0))
        f_row(row + 4, "Open P/L", str.tostring(liveR, "+#.##;-#.##") + " R", liveR >= 0 ? color.new(#00e676, 0) : color.new(#ff1744, 0))
        // Same rule as the ACE OPS app: within 2 candles of the signal and near the entry price
        bool late = liveR > lateEntryR or liveR < -0.5 or (bar_index - entryBar) > 2
        f_row(row + 5, "Still enterable?", late ? "NO, already running, don't chase" : "YES, near entry", late ? color.new(#ffab00, 0) : color.new(#00e676, 0))
        string lotStr = noEdge ? "skip (no edge)" : na(lotsAtEntry) ? "-" : lotsAtEntry < 0.01 ? "< 0.01 (too small, skip)" : str.tostring(lotsAtEntry, "#.##") + (isCent ? " cent" : " std")
        f_row(row + 6, "Lot size", lotStr, color.new(#ffc400, 0))
        f_row(row + 7, "Risk", "R" + str.tostring(riskZarAtEntry, "#.##") + " · " + f_acc(riskZarAtEntry) + " (" + str.tostring(riskPctAtEntry, "#.##") + "%)", color.white)
        row += 8
    else
        [l0, rz0, ml0] = f_lots(atr * 1.3, riskPctNow)
        f_row(row, "Next risk", "R" + str.tostring(balanceZar * riskPctNow / 100, "#.##") + " · " + f_acc(balanceZar * riskPctNow / 100) + " (" + str.tostring(riskPctNow, "#.##") + "%)", color.white)
        f_row(row + 1, "Typical lot", na(l0) ? "-" : l0 < 0.01 ? "< 0.01 (min lot = " + str.tostring(ml0, "#.#") + "%)" : "≈ " + str.tostring(l0, "#.##") + (isCent ? " cent" : " std"), color.new(#ffc400, 0))
        row += 2

    if not compactTbl
        string sess = nyOpenWin ? "GOOD: NY open" : londonWin ? "OK: London" : lateNyWin ? "WEAK: late NY" : "QUIET: Asia"
        color sessC = nyOpenWin ? color.new(#00e676, 0) : londonWin ? color.new(#c6ff00, 0) : lateNyWin ? color.new(#ff6d00, 0) : color.new(#90a4ae, 0)
        f_row(row, "Session now", sess, sessC)
        f_row(row + 1, "Trades / win rate", str.tostring(nTrades) + " / " + (na(winRate) ? "-" : str.tostring(winRate * 100, "#.#") + "%"), color.white)
        f_row(row + 2, "Avg win : avg loss", na(payoff) ? "-" : str.tostring(avgWin, "#.##") + "R : " + str.tostring(avgLoss, "#.##") + "R", color.white)
        f_row(row + 3, "Expectancy", na(expectR) ? "-" : str.tostring(expectR, "+#.###;-#.###") + " R / trade", na(expectR) ? color.white : expectR > 0 ? color.new(#00e676, 0) : color.new(#ff1744, 0))
        string kTxt = na(kellyFull) ? "-" : str.tostring(kellyFull * 100, "#.#") + "% full → " + str.tostring(riskPctNow, "#.##") + "% used" + (kellyReady ? "" : " (warming up)")
        f_row(row + 4, "Kelly", kTxt, noEdge ? color.new(#ff1744, 0) : color.new(#ffc400, 0))
        f_row(row + 5, "Max drawdown", str.tostring(maxDdR, "#.#") + " R", color.new(#ff8a80, 0))

// ───────────────────────────── ALERTS ───────────────────────────────────────
// Alerts are sent by the ACE OPS app (GitHub engine → ntfy / Telegram), not by TradingView.
// This script is for the chart only, so it works on the free TradingView plan.
